{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliCatch",
  "version": "0.2.1",
  "identifier": "com.bilicatch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BiliCatch",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/whisper-cli",
      "binaries/sherpa-onnx-offline"
    ],
    "resources": {
      "binaries/ffmpeg-9.0.1-GPLv3-LICENSE.txt": "licenses/ffmpeg-9.0.1-GPLv3-LICENSE.txt",
      "binaries/whisper.cpp-v1.8.6-MIT-LICENSE.txt": "licenses/whisper.cpp-v1.8.6-MIT-LICENSE.txt",
      "binaries/sherpa-onnx-v1.13.8-Apache-2.0-LICENSE.txt": "licenses/sherpa-onnx-v1.13.8-Apache-2.0-LICENSE.txt",
      "binaries/onnxruntime-v1.28.2-MIT-LICENSE.txt": "licenses/onnxruntime-v1.28.2-MIT-LICENSE.txt",
      "binaries/fire-red-asr2-tokens.txt": "fire-red-asr2-tokens.txt",
      "binaries/ggml.dll": "ggml.dll",
      "binaries/ggml-base.dll": "ggml-base.dll",
      "binaries/ggml-cpu.dll": "ggml-cpu.dll",
      "binaries/whisper.dll": "whisper.dll"
    },
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NTk2RUU4OEM3RTgxNQpSV1FWNk1lSTdwWjFBamUvdnBjakZtdlhVQ2dQS2xCYk1tRkhSK0IrR0lVcjlPNG10T1MwQWYvbQo=",
      "endpoints": [
        "https://github.com/wisdomWindy/bili-catch/releases/latest/download/latest.json"
      ]
    }
  }
}
